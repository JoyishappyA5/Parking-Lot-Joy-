START
  CLASS ParkingBay
    #Constructor (defining bays -> baynumber, carplate, occupied state)
    
    DEFINE __init__(self, baynum):
      self.__baynum = baynum
      self.__plate = ""
      self.__occupied = False
    END CONSTRCUTOR

  #Methods 
    DEFINE parkCar(self, plate)
      CHECK IF a plate is string and is not blank
      CHECK IF the bay is occupied
      "PARK" the car through changing occupied state to True, record carplate
    END method

    DEFINE removeCar(self)
      CHECK if the bay is occupied 
      "REMOVE" car from bay, changing occupied state to False, delete recorded carplate
      END method

    DEFINE isOccupied(self)
      return self.__occupied
    END method

    DEFINE getBayNumber(self)
      return self.__baynum
    END method

    DEFINE getPlate(self)
      return self.__plate
    END method
#END CLASS    

CONSTRUCT a list of bays using constructor (e.g. |ParkingBay(1)|)

DEFINE findBay(lstBays, Baynum)
  FOR bay in lstBays:
    IF bay.getBayNumber() == Baynum
      return bay
    END IF
  END FOR
  return None
END FUNCTION
  
DEFINE displayBay(lstBays)
  FOR bay in lstBays
    IF bay is unoccupied
      PRINt "bay _: unoccupied"
    ELSE
      PRINT "bay _: (plate)"
    END IF
  END FOR
END FUNCTION

DEFINE parkVehicle(lstBays, baynum, carplate)
  REMOVE space in the input carplate
  bay <- findBay(lstBays, baynum) 
  IF bay returns None
    RETURN "Please enter a valid bay number"
  ELSE
    success <- bay.parkCar(carplate)
    IF success
      return success message
    ELSE:
      return error message
    END IF
  END IF
END FUNCTION


DEF removeVehicle(lstBays, baynum, carplate)
  bayn <- findBay(lstBays, baynum)
  REMOVE whitespace from carplate input
  IF bayn doesn't return None
    IF carplate input matches carplate stored and bay is occupied:
      removal <- bayn.removeCar()
      IF removal is True
        RETURN success message
      ELSE
        RETURN Error message
      END IF
    ELSE
      RETURN error message
    END IF
  ELSE
    RETURN error message
  END IF
END FUNCTION


DEFINE loadData
  TRY
    OPEN "Carpark.txt" for reading
      FOR line in file
        REMOVE space and comma
        CHECK if there's 3 parts to it so error file doesn't gets recorded
        RECORD values of bayNum, plate, occupied 
        
        CHECK if bay is integer
        CHECK if bay exist

        REMOVE space in data retrieved

        IF occupied not in ("True", "False")
          CONTINUE
        occupied <- (occupied == "True")
        END IF
        
        IF occupied
          bay.parkCar(plate)
        END IF
      
  EXCEPT FileNotFoundError
    PASS  
END FUNCTION
    

DEFINE saveData
  OPEN "Carpark.txt" for writing
    FOR bay in lstBays
      write to file in form: baynumber, carplate, occupied state
    END FOR
END FUNCTION


#Menu function
