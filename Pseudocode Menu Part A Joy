def calculateTotals():
    occupied_bays <- 0
    FOR bay in Bays:
        IF bay is occupied:
            occupied_bays += 1
        END IF
    END FOR
    unoccupied <- 5 - occupied
    print("Total: 5")
    print(f"occupied: {occupied_bays}")
    print(f"unoccupied: {unoccupied}")
END FUNCTION


define saveData:
    with open("Carpark.txt", "w") as file:
        FOR bayNum, details in Bays.items():
            file.write(
                f"{bayNum}, {details['plate']}, {details['occupied']}\n"
                )
        END FOR
END FUNCTION
    
def loadData():
    try:
        with open("Carpark.txt", "r") as file:
            FOR line in file:
                line <- line.strip()
                bayNum, plate, occupied = line.split(",")
                bayNum <- int(bayNum)
                occupied <- occupied.strip()
                plate <- plate.strip()
                IF occupied is "True":
                    occupied <- True
                ELSE:
                    occupied <- False
                END IF
                Bays[bayNum] <- {
                    "plate": plate,
                    "occupied": occupied}
            END FOR
    except FileNotFoundError:
        pass
END FUNCTION
