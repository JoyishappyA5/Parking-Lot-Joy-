START

INITIALISE bays in the format
  bay number: {carplate: "", occupied: False}

FUNCTION display_menu
  SET running to True
  WHILE running is True
    DISPLAY "Parking Lot Tracker"
    DISPLAY all the options 1-5
    choice <- int(input("Enter your choice: "))
    IF choice is 1
            CALL recordEntry
    ELSE IF choice is 2
            CALL removeCar
    ELSE IF choice is 3
            CALL viewStatus
    ELSE IF choice is 4
            CALL calculateTotals
    ELSE IF choice is 5
            CALL saveData
            SET running to False
    END IF

    END FUNCTION




FUNCTION recordEntry
  bay <- user's input bay number
  IF bay is within range of carpark
   IF the bay is occupied:
      DISPLAY "Bay is already occupied."
   ELSE
      car_plate <- input("Enter car number plate:")
      Bays[bay]["plate"] = car_plate
      SET bay occupied to True
      DISPLAY f"Car with plate {car_plate} has parked in bay {bay}."
    END IF
   END IF
END FUNCTION



FUNCTION removeCar
    cp <- input("Enter car number plate: ")
    SET found to False
    FOR bay, details in Bays.items()
        IF license plate matches
            DISPLAY f"you parked your car in {bay}"
            Bay[bay]["plate"] = ""
            SET occupied to False
            SET found to True
            print("Have a lovely day! Thank you for parking in xx parking")
            break
        END IF
    END FOR
    IF not found
       DISPLAY"we could not find your carplate in the system"
    END IF
END FUNCTION

FUNCTION viewstatus
    DISPLAY carpark heading
    FOR each bay
        IF occupied
            SET status to licence plate
        ELSE
            SET status to "UNOCCUPIED"
        END IF

        DISPLAY bay and status
    END FOR
END FUNCTION

        
        
FUNCTION calculateTotals():
    occupied_bays <- 0
    FOR each bay:
        IF bay is occupied:
            ADD 1 to occupied_bays
        END IF
    END FOR
    CALCULATE unoccupied bays
    DISPLAY totals
END FUNCTION


FUNCTION saveData
    OPEN Carpark.txt for writing
        FOR each bay
            write bay number, carplate, occupied state
        END FOR
    CLOSE file
END FUNCTION
    

FUNCTION loadData
    TRY open Carpark.txt for reading
            FOR each line in file
                SPLIT each line into baynumber, plate and occupied state
                CONVERT data into correct data type
                UPDATE bays
            END FOR
    IF file does not exist
            continue with default Bays
    END IF
END FUNCTION

CALL loadData
CALL display_menu

END
